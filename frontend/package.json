{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=26.13.0",
		"npm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"typesafe-i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/noto-serif": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typesafe-i18n": "^5.27.1",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"overrides": {
		"cookie": "^2.0.1"
	},
	"allowScripts": {
		"@tailwindcss/oxide@4.1.12": true,
		"esbuild@0.27.7": true
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#i18n/*": "./src/i18n/*"
	}
}
